<UserControl x:Class="AccEngineer.UI.Controls.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AccEngineer.UI.Controls">
    <Border Style="{StaticResource Card}" Margin="0,0,10,10">
        <StackPanel>
            <TextBlock Style="{StaticResource MetricLabel}" Text="{Binding Label, RelativeSource={RelativeSource AncestorType=local:MetricCard}}" />
            <TextBlock Style="{StaticResource MetricValue}" Text="{Binding Value, RelativeSource={RelativeSource AncestorType=local:MetricCard}}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource Caption}" Text="{Binding Caption, RelativeSource={RelativeSource AncestorType=local:MetricCard}}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Border>
</UserControl>
