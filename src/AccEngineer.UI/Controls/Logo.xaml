<UserControl x:Class="AccEngineer.UI.Controls.Logo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <!-- Vector reproduction of logo.svg (Sim-Racing Engineer). Scalable via the Viewbox. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="240" Height="240">
            <!-- Background dark circle -->
            <Ellipse Canvas.Left="12" Canvas.Top="12" Width="216" Height="216"
                     Fill="#0F1115" Stroke="#181B22" StrokeThickness="1.5" />

            <!-- Subtle track-map outline (abstract circuit) -->
            <Path Data="M 60 140 Q 90 80 140 100 T 190 130"
                  Fill="{x:Null}" Stroke="#C8F64E" StrokeThickness="0.75" Opacity="0.25"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Ellipse Canvas.Left="137.5" Canvas.Top="97.5" Width="5" Height="5" Fill="#C8F64E" Opacity="0.7" />
            <Ellipse Canvas.Left="188" Canvas.Top="128" Width="4" Height="4" Fill="#C8F64E" Opacity="0.5" />

            <!-- Telemetry / dash lines -->
            <Line X1="55" Y1="160" X2="95" Y2="160" Stroke="#C8F64E" StrokeThickness="1" Opacity="0.5" />
            <Line X1="55" Y1="168" X2="80" Y2="168" Stroke="#C8F64E" StrokeThickness="0.75" Opacity="0.3" />

            <!-- Sharp racing monogram / emblem (with glow) -->
            <Canvas>
                <Canvas.Effect>
                    <DropShadowEffect Color="#C8F64E" BlurRadius="6" ShadowDepth="0" Opacity="0.35" />
                </Canvas.Effect>
                <Polygon Points="120,62 160,110 120,140 80,110" Fill="#C8F64E" Opacity="0.95" />
                <Polygon Points="120,72 148,110 120,132 92,110" Fill="#0F1115" />
                <Ellipse Canvas.Left="116.5" Canvas.Top="106.5" Width="7" Height="7" Fill="#C8F64E" />
            </Canvas>

            <!-- Typography -->
            <TextBlock Canvas.Left="0" Canvas.Top="161" Width="240"
                       TextAlignment="Center" Text="SIM-RACING"
                       FontFamily="Segoe UI" FontSize="14.5" FontWeight="ExtraBold" FontStyle="Italic"
                       Foreground="#F2F3F5" />
            <TextBlock Canvas.Left="0" Canvas.Top="183" Width="240"
                       TextAlignment="Center" Text="ENGINEER"
                       FontFamily="Segoe UI" FontSize="7.5" FontWeight="Bold"
                       Foreground="#C8F64E" />

            <!-- Small decorative tick marks -->
            <Line X1="52" Y1="110" X2="58" Y2="110" Stroke="#C8F64E" StrokeThickness="1.5" Opacity="0.7" />
            <Line X1="182" Y1="110" X2="188" Y2="110" Stroke="#C8F64E" StrokeThickness="1.5" Opacity="0.7" />
        </Canvas>
    </Viewbox>
</UserControl>
