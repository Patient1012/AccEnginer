<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>AccEngineer.UI</RootNamespace>
    <AssemblyName>AccEngineer.UI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.3.0</Version>
    <Product>ACC Engineer</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccEngineer.Telemetry\AccEngineer.Telemetry.csproj" />
    <ProjectReference Include="..\AccEngineer.Analysis\AccEngineer.Analysis.csproj" />
    <ProjectReference Include="..\AccEngineer.AI\AccEngineer.AI.csproj" />
    <ProjectReference Include="..\AccEngineer.Reporting\AccEngineer.Reporting.csproj" />
    <ProjectReference Include="..\AccEngineer.Pipeline\AccEngineer.Pipeline.csproj" />
    <ProjectReference Include="..\AccEngineer.Storage\AccEngineer.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.14" />
  </ItemGroup>

</Project>
