<UserControl x:Class="AccEngineer.UI.Views.FuelCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:AccEngineer.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="520">
    <!--
        The Fuel Calculator page is scoped to its own near-black, high-contrast palette so it
        reads like a dedicated motorsport planner rather than the application's blue-grey
        dashboard. The brushes and control styles below are local to this page and deliberately
        small-radius / pill-shaped; the rest of the application keeps the shared theme.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringMatchToBoolConverter x:Key="StringMatch" />

        <SolidColorBrush x:Key="FuelBrushPage" Color="#FF000000" />
        <SolidColorBrush x:Key="FuelBrushSurface" Color="#FF101010" />
        <SolidColorBrush x:Key="FuelBrushCard" Color="#FF171717" />
        <SolidColorBrush x:Key="FuelBrushInput" Color="#FF0A0A0A" />
        <SolidColorBrush x:Key="FuelBrushBorder" Color="#FF303030" />
        <SolidColorBrush x:Key="FuelBrushBorderStrong" Color="#FF414141" />
        <SolidColorBrush x:Key="FuelBrushTextPrimary" Color="#FFF2F2F2" />
        <SolidColorBrush x:Key="FuelBrushTextSecondary" Color="#FFA0A0A0" />
        <SolidColorBrush x:Key="FuelBrushTextMuted" Color="#FF858585" />
        <SolidColorBrush x:Key="FuelBrushAccent" Color="#FF20E69A" />
        <SolidColorBrush x:Key="FuelBrushAccentDim" Color="#FF0E5C3E" />
        <SolidColorBrush x:Key="FuelBrushWarning" Color="#FFFFC24D" />
        <SolidColorBrush x:Key="FuelBrushError" Color="#FFFF6B74" />
        <SolidColorBrush x:Key="FuelBrushOnAccent" Color="#FF06120D" />

        <!-- Compact section label used to introduce each group of the form. -->
        <Style x:Key="FuelSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FuelBrushTextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="FuelFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource FuelBrushTextMuted}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- The value that matters most: white, bold, and slightly larger than body text. -->
        <Style x:Key="FuelValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FuelBrushTextPrimary}" />
        </Style>

        <Style x:Key="FuelValueMuted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource FuelBrushTextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Dark numeric input, matching the reference's thin grey border and small radius. -->
        <Style x:Key="FuelInput" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FuelBrushInput}" />
            <Setter Property="Foreground" Value="{StaticResource FuelBrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource FuelBrushBorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="{StaticResource FuelBrushAccent}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same input but with a right-aligned muted unit suffix inside the field. -->
        <Style x:Key="FuelInputWithUnit" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource FuelBrushTextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="{StaticResource FuelBrushAccent}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FuelFieldFrame" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FuelBrushInput}" />
            <Setter Property="BorderBrush" Value="{StaticResource FuelBrushBorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="36" />
        </Style>

        <!-- Fully rounded dark button (Clear). -->
        <Style x:Key="FuelGhostButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FuelBrushCard}" />
            <Setter Property="Foreground" Value="{StaticResource FuelBrushTextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource FuelBrushBorderStrong}" BorderThickness="1"
                                CornerRadius="15" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF232323" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fully rounded bright-green primary button (Calculate / Save). -->
        <Style x:Key="FuelPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FuelBrushAccent}" />
            <Setter Property="Foreground" Value="{StaticResource FuelBrushOnAccent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="15"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The small outlined "Ghost"/pill button used for inline secondary actions. -->
        <Style x:Key="FuelPillButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource FuelBrushTextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent"
                                BorderBrush="{StaticResource FuelBrushBorderStrong}" BorderThickness="1"
                                CornerRadius="13" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF1F1F1F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill-style segmented option: a RadioButton painted as a rounded toggle. The selected
             option gets the white pill with dark text; the unselected one stays muted on charcoal. -->
        <Style x:Key="FuelSegmentOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource FuelBrushTextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="12" Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource FuelBrushTextPrimary}" />
                                <Setter Property="Foreground" Value="{StaticResource FuelBrushOnAccent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource FuelBrushPage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!-- The reference is a narrow phone-width column; centre it and cap the width so a
                 wide desktop monitor never stretches inputs across the whole screen. -->
            <StackPanel MaxWidth="520" HorizontalAlignment="Center" Margin="0,0,0,24">

                <!-- Header: bold title with a thin bottom rule and unobtrusive data-source text. -->
                <Border BorderBrush="{StaticResource FuelBrushBorder}" BorderThickness="0,0,0,1"
                        Padding="14,16" MinHeight="74">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DataSourceText}" FontSize="11"
                                   Foreground="{StaticResource FuelBrushTextMuted}" VerticalAlignment="Center" />
                        <TextBlock Text="Fuel Calculator" FontSize="29" FontWeight="Bold"
                                   Foreground="{StaticResource FuelBrushTextPrimary}" />
                    </DockPanel>
                </Border>

                <!-- Main form container. -->
                <Border Background="{StaticResource FuelBrushSurface}" BorderBrush="{StaticResource FuelBrushBorder}"
                        BorderThickness="1" CornerRadius="15" Padding="13,14" Margin="0,12,0,0">
                    <StackPanel>

                        <!-- Stint: compact card with the planned-stint length and its fuel need. -->
                        <Border Background="{StaticResource FuelBrushCard}" BorderBrush="{StaticResource FuelBrushBorder}"
                                BorderThickness="1" CornerRadius="9" Padding="15" MinHeight="88">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Stint" FontSize="11"
                                               Foreground="{StaticResource FuelBrushTextMuted}" />
                                    <TextBlock Text="Planned stint" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource FuelBrushTextPrimary}" Margin="0,4,0,0" />
                                    <Grid Margin="0,8,0,0" MaxWidth="200" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource FuelFieldFrame}" Height="32">
                                            <Grid>
                                                <TextBox Style="{StaticResource FuelInputWithUnit}"
                                                         Text="{Binding StintLaps, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="laps" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           FontSize="12" Foreground="{StaticResource FuelBrushTextMuted}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding StintFuelRequiredText, StringFormat=Requires {0}}"
                                               FontSize="11" Foreground="{StaticResource FuelBrushTextMuted}"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Use live fuel" Style="{StaticResource FuelPillButton}"
                                        VerticalAlignment="Top" Command="{Binding ResetLiveFuelCommand}"
                                        Visibility="{Binding CurrentFuelOverridden, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>

                        <!-- Race length: remaining laps plus the litres/laps display-unit pill. -->
                        <TextBlock Text="Race Length" Style="{StaticResource FuelSectionLabel}" Margin="2,16,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Remaining race laps" VerticalAlignment="Center"
                                       Foreground="{StaticResource FuelBrushTextPrimary}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Background="{StaticResource FuelBrushCard}" CornerRadius="14" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource FuelSegmentOption}" Content="Litres"
                                                     GroupName="FuelUnit"
                                                     IsChecked="{Binding DisplayUnit, Converter={StaticResource StringMatch}, ConverterParameter=Litres, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource FuelSegmentOption}" Content="Laps"
                                                     GroupName="FuelUnit"
                                                     IsChecked="{Binding DisplayUnit, Converter={StaticResource StringMatch}, ConverterParameter=Laps, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBox Style="{StaticResource FuelInput}" Margin="0,8,0,0"
                                 Text="{Binding ManualRemainingLaps, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Laptime: the measured average, shown as a compact secondary value. -->
                        <TextBlock Text="Laptime" Style="{StaticResource FuelSectionLabel}" Margin="2,16,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Measured average" VerticalAlignment="Center"
                                       Foreground="{StaticResource FuelBrushTextPrimary}" />
                            <TextBlock Grid.Column="1" Text="{Binding AvgLapSecondsText}" Style="{StaticResource FuelValue}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Fuel consumption and tank capacity side by side. -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Fuel Consumption" Style="{StaticResource FuelFieldLabel}" />
                                <Border Style="{StaticResource FuelFieldFrame}">
                                    <Grid>
                                        <TextBox Style="{StaticResource FuelInputWithUnit}"
                                                 Text="{Binding ManualConsumptionText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="L/Lap" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{StaticResource FuelBrushTextMuted}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding ConsumptionText}" FontSize="10"
                                           Foreground="{StaticResource FuelBrushTextMuted}" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tank Capacity" Style="{StaticResource FuelFieldLabel}" />
                                <Border Style="{StaticResource FuelFieldFrame}">
                                    <Grid>
                                        <TextBlock Text="{Binding TankCapacityText}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource FuelBrushTextPrimary}" FontSize="14" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding TankCapacityWarningText}" FontSize="10"
                                           Foreground="{StaticResource FuelBrushWarning}" Margin="0,4,0,0"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TankCapacityWarningText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TankCapacityWarningText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- Current fuel and finish reserve. -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Current Fuel" Style="{StaticResource FuelFieldLabel}" />
                                <Border Style="{StaticResource FuelFieldFrame}">
                                    <Grid>
                                        <TextBox Style="{StaticResource FuelInputWithUnit}"
                                                 Text="{Binding CurrentFuelLitres, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="L" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{StaticResource FuelBrushTextMuted}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Finish Reserve" Style="{StaticResource FuelFieldLabel}" />
                                <Border Style="{StaticResource FuelFieldFrame}">
                                    <Grid>
                                        <TextBox Style="{StaticResource FuelInputWithUnit}"
                                                 Text="{Binding ReserveLitres, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="L" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{StaticResource FuelBrushTextMuted}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Safety margin. -->
                        <TextBlock Text="Safety Margin" Style="{StaticResource FuelSectionLabel}" Margin="2,16,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mode" Style="{StaticResource FuelFieldLabel}" />
                                <ComboBox Style="{StaticResource InputCombo}" Height="36"
                                          SelectedValuePath="Content"
                                          SelectedValue="{Binding SafetyMarginMode, Mode=TwoWay}">
                                    <ComboBoxItem Content="Litres" />
                                    <ComboBoxItem Content="Percentage" />
                                    <ComboBoxItem Content="Both" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Litres" Style="{StaticResource FuelFieldLabel}" />
                                <Border Style="{StaticResource FuelFieldFrame}">
                                     <TextBox Style="{StaticResource FuelInputWithUnit}"
                                              Text="{Binding SafetyMarginLitres, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding SafetyMarginLitresEnabled}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Percent" Style="{StaticResource FuelFieldLabel}" />
                                <Border Style="{StaticResource FuelFieldFrame}">
                                    <Grid>
                                        <TextBox Style="{StaticResource FuelInputWithUnit}"
                                                 Text="{Binding SafetyMarginPercent, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding SafetyMarginPercentEnabled}" />
                                        <TextBlock Text="%" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{StaticResource FuelBrushTextMuted}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Filters: the honest, existing session-estimate toggle. -->
                        <TextBlock Text="Filters" Style="{StaticResource FuelSectionLabel}" Margin="2,16,0,6" />
                        <CheckBox IsChecked="{Binding PreferTimeLimitedEstimate}"
                                  Foreground="{StaticResource FuelBrushTextSecondary}"
                                  Content="Estimate remaining laps from session time (time-limited sessions)" />

                        <!-- Actions: Clear resets the live-derived current fuel; Save persists defaults. -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Clear" Style="{StaticResource FuelGhostButton}"
                                    Command="{Binding ResetLiveFuelCommand}" />
                            <Button Grid.Column="2" Content="Save as defaults" Style="{StaticResource FuelPrimaryButton}"
                                    Command="{Binding SaveCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Results: the same compact visual language, not the old oversized dashboard cards. -->
                <Border Background="{StaticResource FuelBrushSurface}" BorderBrush="{StaticResource FuelBrushBorder}"
                        BorderThickness="1" CornerRadius="15" Padding="15" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Result" Style="{StaticResource FuelSectionLabel}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Fuel to add" FontSize="11"
                                           Foreground="{StaticResource FuelBrushTextMuted}" />
                                <TextBlock Text="{Binding FuelToAddText}" FontSize="34" FontWeight="Bold"
                                           Foreground="{StaticResource FuelBrushAccent}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="{StaticResource FuelBrushBorder}" BorderThickness="0,1,0,0"
                                Margin="0,12,0,0" Padding="0,8,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Current fuel" Style="{StaticResource FuelValueMuted}" />
                            <TextBlock Grid.Column="1" Text="{Binding CurrentFuelText}" Style="{StaticResource FuelValue}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Base fuel required" Style="{StaticResource FuelValueMuted}" />
                            <TextBlock Grid.Column="1" Text="{Binding BaseFuelRequiredText}" Style="{StaticResource FuelValue}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Safety margin" Style="{StaticResource FuelValueMuted}" />
                            <TextBlock Grid.Column="1" Text="{Binding SafetyMarginAppliedText}" Style="{StaticResource FuelValue}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Finish reserve" Style="{StaticResource FuelValueMuted}" />
                            <TextBlock Grid.Column="1" Text="{Binding ReserveAppliedText}" Style="{StaticResource FuelValue}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Total fuel required" Style="{StaticResource FuelValueMuted}" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalFuelRequiredText}" Style="{StaticResource FuelValue}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Laps possible on current fuel" Style="{StaticResource FuelValueMuted}" />
                            <TextBlock Grid.Column="1" Text="{Binding LapsPossibleText}" Style="{StaticResource FuelValue}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Surplus / shortfall" Style="{StaticResource FuelValueMuted}" />
                            <TextBlock Grid.Column="1" Text="{Binding SurplusShortfallText}" Style="{StaticResource FuelValue}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Stint fuel (required / left)"
                                       Style="{StaticResource FuelValueMuted}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding StintFuelRequiredText}" Style="{StaticResource FuelValue}" />
                                <TextBlock Text=" / " Foreground="{StaticResource FuelBrushTextMuted}" />
                                <TextBlock Text="{Binding StintReserveAtEndText}" Style="{StaticResource FuelValue}" />
                                <TextBlock Text=" (" Foreground="{StaticResource FuelBrushTextMuted}" />
                                <TextBlock Text="{Binding StintSufficiencyText}" Style="{StaticResource FuelValue}" />
                                <TextBlock Text=")" Foreground="{StaticResource FuelBrushTextMuted}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding BreakdownText}" FontSize="11"
                                   Foreground="{StaticResource FuelBrushTextMuted}" Margin="0,12,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Consumption status: the retained measurement details in compact secondary text. -->
                <Border Background="{StaticResource FuelBrushSurface}" BorderBrush="{StaticResource FuelBrushBorder}"
                        BorderThickness="1" CornerRadius="15" Padding="15" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Fuel Data" Style="{StaticResource FuelSectionLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Clean laps used" Style="{StaticResource FuelValueMuted}" />
                            <TextBlock Grid.Column="1" Text="{Binding ValidLapCountText}" Style="{StaticResource FuelValue}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Confidence" Style="{StaticResource FuelValueMuted}" />
                            <TextBlock Grid.Column="1" Text="{Binding ConfidenceText}" Style="{StaticResource FuelValue}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Remaining laps" Style="{StaticResource FuelValueMuted}" />
                            <TextBlock Grid.Column="1" Text="{Binding RemainingRaceLapsText}" Style="{StaticResource FuelValue}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tank capacity" Style="{StaticResource FuelValueMuted}" />
                            <TextBlock Grid.Column="1" Text="{Binding TankCapacityText}" Style="{StaticResource FuelValue}" />
                        </Grid>
                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                   Foreground="{StaticResource FuelBrushTextSecondary}" Margin="0,12,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource FuelBrushTextMuted}"
                                   Text="Leave consumption empty to use the measured average from completed laps. Invalid laps, refuels and implausible readings are excluded. Enter a value to override the measurement." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
