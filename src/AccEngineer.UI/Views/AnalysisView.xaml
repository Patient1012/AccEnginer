<UserControl x:Class="AccEngineer.UI.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AccEngineer.UI.Converters"
             xmlns:ctrl="clr-namespace:AccEngineer.UI.Controls"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Analysis" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Analyse Session" Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Top" Command="{Binding AnalyseCommand}" />
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                    Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel>
                    <TextBlock Text="No analysis yet" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Drive in ACC or replay a recording, then choose Analyse Session to reconstruct laps and compare them." />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVis}}">
                <UniformGrid Columns="3" Margin="0,12,0,0">
                    <ctrl:MetricCard Label="REFERENCE LAP" Value="{Binding ReferenceText}" />
                    <ctrl:MetricCard Label="DATA QUALITY" Value="{Binding DataQualityText}" />
                    <ctrl:MetricCard Label="DRIVING FINDINGS" Value="{Binding FindingsSummary}" />
                </UniformGrid>

                <TextBlock Text="LAPS" Style="{StaticResource SectionHeader}" Margin="0,16,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="LAP" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="1" Text="TIME" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="2" Text="STATUS" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="3" Text="SOURCE" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="4" Text="SAMPLES" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="5" Text="SECTORS" Style="{StaticResource Caption}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Laps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding LapNumber}" />
                                        <TextBlock Grid.Column="1" Text="{Binding LapTime}" />
                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Source}"
                                                   Foreground="{DynamicResource BrushTextSecondary}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Samples}"
                                                   Foreground="{DynamicResource BrushTextSecondary}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Sectors}"
                                                   Foreground="{DynamicResource BrushTextSecondary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="GAIN / LOSS VS REFERENCE" Style="{StaticResource SectionHeader}" Margin="0,16,0,8" />
                <ItemsControl ItemsSource="{Binding Comparison}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Lap " />
                                        <TextBlock Text="{Binding LapNumber}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding LapTime}" Margin="16,0,0,0"
                                                   Foreground="{DynamicResource BrushTextSecondary}" />
                                        <TextBlock Text="{Binding TotalDelta}" Margin="16,0,0,0" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Regions}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Type}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrushError}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsGain}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1" Text="{Binding Range}"
                                                               Foreground="{DynamicResource BrushTextSecondary}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Delta}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No significant gain or loss regions." Style="{StaticResource Caption}"
                                               Visibility="{Binding HasRegions, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="DRIVING FINDINGS" Style="{StaticResource SectionHeader}" Margin="0,16,0,8" />
                <TextBlock Text="Measured facts from braking, corner, throttle and tyre channels. Possible explanations are labelled separately and are never treated as proven."
                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{Binding AiNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="No driving findings were produced from this recording." Style="{StaticResource Caption}"
                           Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                <ItemsControl ItemsSource="{Binding Findings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Header}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Severity}"
                                                   Foreground="{DynamicResource BrushTextSecondary}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Observation}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Interpretation}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource BrushWarning}"
                                               Visibility="{Binding HasInterpretation, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Limitation}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding HasLimitation, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="{Binding InterpretLabel}" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Command="{Binding InterpretCommand}" />
                                    <TextBlock Text="{Binding AiError}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{DynamicResource BrushError}"
                                               Visibility="{Binding HasAiError, Converter={StaticResource BoolToVis}}" />
                                    <Border Margin="0,8,0,0" Padding="10" CornerRadius="4"
                                            Background="{DynamicResource BrushSurfaceAlt}"
                                            Visibility="{Binding HasAiResult, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="AI INTERPRETATION (POSSIBLE CAUSE, NOT PROVEN)"
                                                       Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding AiObservation}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding AiInterpretation}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource BrushWarning}"
                                                       Visibility="{Binding HasAiInterpretation, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding AiTest}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HasAiTest, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding AiLimitations}" Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HasAiLimitations, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="SESSION EVENTS" Style="{StaticResource SectionHeader}" Margin="0,16,0,8" />
                <TextBlock Text="Lap completions, invalid laps and telemetry-quality notices recorded while the session ran."
                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
