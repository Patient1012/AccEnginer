<UserControl x:Class="AccEngineer.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AccEngineer.UI.Converters"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Reports" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Generate from Session" Style="{StaticResource PrimaryButton}"
                            Command="{Binding GenerateCommand}" />
                    <Button Content="Refresh" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding RefreshCommand}" />
                    <Button Content="Folder" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding OpenFolderCommand}" />
                </StackPanel>
                <Border Style="{StaticResource Card}" Padding="6">
                    <StackPanel>
                        <TextBlock Text="No reports yet." Style="{StaticResource Caption}" Margin="8"
                                   Visibility="{Binding HasReports, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <ListBox ItemsSource="{Binding Reports}" SelectedItem="{Binding Selected}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CreatedText}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12"
                             Background="{DynamicResource BrushBackground}"
                             Foreground="{DynamicResource BrushTextPrimary}"
                             BorderThickness="0" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Copy for ChatGPT" Style="{StaticResource PrimaryButton}"
                                Command="{Binding CopyCommand}" />
                        <Button Content="Save Copy" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding ExportCommand}" />
                        <Button Content="Delete" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding DeleteCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
