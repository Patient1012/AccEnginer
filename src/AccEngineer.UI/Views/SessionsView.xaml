<UserControl x:Class="AccEngineer.UI.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AccEngineer.UI.Converters"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Sessions" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Refresh" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" />
                    <Button Content="Folder" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding OpenFolderCommand}" />
                    <Button Content="Stop Replay" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding StopReplayCommand}" />
                </StackPanel>
                <Border Style="{StaticResource Card}" Padding="6">
                    <StackPanel>
                        <TextBlock Text="No recordings found." Style="{StaticResource Caption}" Margin="8"
                                   Visibility="{Binding HasRecordings, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <ListBox ItemsSource="{Binding Recordings}" SelectedItem="{Binding Selected}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StartedText}" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding TrackText}" Style="{StaticResource Caption}" Margin="10,0,0,0" />
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" Margin="10,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource BrushError}"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Visibility="{Binding IsReadable, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Recording detail" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Select a recording to replay it, generate a report, or delete it."
                               Style="{StaticResource Caption}"
                               Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Selected.FileName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Track" Style="{StaticResource Caption}" Margin="0,3" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Selected.TrackText}" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Car" Style="{StaticResource Caption}" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.CarText}" Margin="0,3" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Session" Style="{StaticResource Caption}" Margin="0,3" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.SessionTypeText}" Margin="0,3" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Started" Style="{StaticResource Caption}" Margin="0,3" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.StartedText}" Margin="0,3" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Size" Style="{StaticResource Caption}" Margin="0,3" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Selected.SizeText}" Margin="0,3" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Replay" Style="{StaticResource PrimaryButton}" Command="{Binding ReplayCommand}" />
                            <Button Content="Generate Report" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding ReportCommand}" />
                            <Button Content="Delete" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding DeleteCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
