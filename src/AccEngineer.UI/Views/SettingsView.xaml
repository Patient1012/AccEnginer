<UserControl x:Class="AccEngineer.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />

            <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Theme" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Width="280" HorizontalAlignment="Left"
                                  Style="{StaticResource InputCombo}"
                                  ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  DisplayMemberPath="Name" />
                    </Grid>

                    <TextBlock Text="Preview" Style="{StaticResource Caption}" Margin="0,14,0,6" />

                    <!-- Every value below is a live resource reference, so this follows the
                         selected theme with no second palette defined anywhere. -->
                    <Border Background="{DynamicResource BrushBackground}"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="SESSION" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="P1" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="&#160;&#160;·&#160;&#160;" FontSize="22"
                                           Foreground="{DynamicResource BrushTextMuted}" />
                                <TextBlock Text="3rd" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAccent}" />
                                <TextBlock Text="&#160;&#160;·&#160;&#160;" FontSize="22"
                                           Foreground="{DynamicResource BrushTextMuted}" />
                                <TextBlock Text="1:42.318" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Primary" Style="{StaticResource PrimaryButton}" />
                                <Button Content="Ghost" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                                <Border Margin="8,0,0,0" Padding="10,5" CornerRadius="5"
                                        Background="{DynamicResource BrushAccentDim}">
                                    <TextBlock Text="GREEN FLAG" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushAccent}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Width="46" Height="28" CornerRadius="5" BorderThickness="1"
                                Background="{DynamicResource BrushBackground}"
                                BorderBrush="{DynamicResource BrushBorder}" />
                        <Border Width="46" Height="28" CornerRadius="5" Margin="6,0,0,0" BorderThickness="1"
                                Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}" />
                        <Border Width="46" Height="28" CornerRadius="5" Margin="6,0,0,0" BorderThickness="1"
                                Background="{DynamicResource BrushSurfaceAlt}"
                                BorderBrush="{DynamicResource BrushBorder}" />
                        <Border Width="46" Height="28" CornerRadius="5" Margin="6,0,0,0"
                                Background="{DynamicResource BrushAccent}" />
                        <Border Width="46" Height="28" CornerRadius="5" Margin="6,0,0,0"
                                Background="{DynamicResource BrushSuccess}" />
                        <Border Width="46" Height="28" CornerRadius="5" Margin="6,0,0,0"
                                Background="{DynamicResource BrushWarning}" />
                        <Border Width="46" Height="28" CornerRadius="5" Margin="6,0,0,0"
                                Background="{DynamicResource BrushError}" />
                        <Border Width="46" Height="28" CornerRadius="5" Margin="6,0,0,0"
                                Background="{DynamicResource BrushInfo}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="Applies as soon as it is picked and is saved to settings.json. Overlay panels use the same theme. A theme name that is missing or no longer recognised falls back to Default rather than leaving the application unstyled." />
                </StackPanel>
            </Border>

            <TextBlock Text="TELEMETRY READER" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Poll interval (ms)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                             Style="{StaticResource InputBox}" Text="{Binding PollIntervalMs}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Recordings directory" VerticalAlignment="Center" Margin="0,10,0,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InputBox}" Margin="0,10,0,0"
                             Text="{Binding RecordingsDirectory}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Reports directory" VerticalAlignment="Center" Margin="0,10,0,0" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource InputBox}" Margin="0,10,0,0"
                             Text="{Binding ReportsDirectory}" />
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Save Settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                <Button Content="Open Recordings" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Command="{Binding OpenRecordingsCommand}" />
                <Button Content="Open Reports" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Command="{Binding OpenReportsCommand}" />
            </StackPanel>

            <TextBlock Text="TEST DATA" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Test data mode" VerticalAlignment="Center" />
                        <CheckBox Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Foreground="{DynamicResource BrushTextPrimary}"
                                  IsChecked="{Binding TestDataMode, Mode=TwoWay}"
                                  Content="Run the whole app on generated telemetry" />
                    </Grid>

                    <TextBlock Text="{Binding TestDataStatusText}" TextWrapping="Wrap" Margin="0,10,0,0"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource BrushWarning}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TestDataStatusText}" Value="Test Data: OFF — reading ACC shared memory.">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Feeds deterministic, self-consistent generated telemetry through the same pipeline as the live reader, so every page and overlay can be exercised without launching ACC. Applies immediately and is saved to settings.json; it is restored on the next start. The status line above always reflects the provider actually in effect." />
                </StackPanel>
            </Border>

            <TextBlock Text="BROADCASTING" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ACC broadcasting" VerticalAlignment="Center" />
                        <CheckBox Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Foreground="{DynamicResource BrushTextPrimary}"
                                  IsChecked="{Binding BroadcastingEnabled, Mode=TwoWay}"
                                  Content="Connect for competitor data (names, numbers, teams, gaps)" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Listener port" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Width="120" HorizontalAlignment="Left"
                                 Text="{Binding BroadcastingPort, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Connection password" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{StaticResource InputBox}"
                                 Text="{Binding BroadcastingPassword, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock Text="{Binding BroadcastingStatusText}" TextWrapping="Wrap" Margin="0,10,0,0"
                               FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />

                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Competitor names, race numbers, teams and official gaps exist only in the ACC UDP Broadcasting API; shared memory does not expose them. Create or edit Documents\Assetto Corsa Competizione\Config\broadcasting.json with a udpListenerPort and connectionPassword matching the values above, then restart ACC. Until then the standings and relative name columns show an explicit unavailable state rather than invented data." />
                </StackPanel>
            </Border>

            <TextBlock Text="AI PROVIDER" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding AiStatusText}" TextWrapping="Wrap" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource InputBox}"
                                 Text="{Binding AiProvider, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Model" VerticalAlignment="Center" Margin="0,10,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InputBox}" Margin="0,10,0,0"
                                 Text="{Binding AiModel, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Endpoint (optional)" VerticalAlignment="Center" Margin="0,10,0,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource InputBox}" Margin="0,10,0,0"
                                 Text="{Binding AiEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Set provider to openrouter, ollama or lmstudio to infer the endpoint, or supply a full base URL. The API key is read from the ACCENGINEER_AI_API_KEY (or OPENROUTER_API_KEY) environment variable and is never saved here." />
                </StackPanel>
            </Border>

            <TextBlock Text="OVERLAY" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding OverlayStatusText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Show / Hide Overlay" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ToggleOverlayCommand}" />
                        <Button Content="Toggle Edit Mode" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding EditOverlayCommand}" />
                        <Button Content="Reset Layout" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding ResetOverlayCommand}" />
                        <Button Content="Toggle Demo Data" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding ToggleDemoOverlayCommand}" />
                        <Button Content="Configure Overlay…" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Command="{Binding ConfigureOverlayCommand}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding OverlayPanels}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Caption}">
                                    <Run Text="{Binding Title}" />
                                    <Run Text=" - " />
                                    <Run Text="{Binding IsVisible}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Transparent, always-on-top panels that are click-through while locked. Enter edit mode to drag and resize each panel; placement is saved to %AppData%\AccEngineer\overlay.json. Demo data feeds synthetic telemetry so you can tune the layout without launching ACC." />
                </StackPanel>
            </Border>

            <TextBlock Text="APPLICATION" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Settings file" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding SettingsPathText}" TextWrapping="Wrap" />
                    <TextBlock Text="ACC Engineer aligns with the ACC Telemetry AI roadmap and UI design."
                               Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
