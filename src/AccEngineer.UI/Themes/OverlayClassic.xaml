<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Phase 1 classic overlay theme (circa-2020 broadcast / RaceLab legacy look).
      Colours are centralised here so later phases can add alt themes without
      touching panel markup. Keys are Prefixed "Overlay" to avoid clashing with the
      main app palette.
    -->
    <SolidColorBrush x:Key="OverlayPanelBrush" Color="#E6101012" />
    <SolidColorBrush x:Key="OverlayHeaderBrush" Color="#FF161718" />
    <SolidColorBrush x:Key="OverlayBorderBrush" Color="#FF4A4A4E" />
    <SolidColorBrush x:Key="OverlaySeparatorBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="OverlayTextBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="OverlayMutedBrush" Color="#FFA6ACB4" />
    <SolidColorBrush x:Key="OverlayAccentBrush" Color="#FFB7F34A" />
    <SolidColorBrush x:Key="OverlaySuccessBrush" Color="#FF63D67F" />
    <SolidColorBrush x:Key="OverlayWarningBrush" Color="#FFE7C34A" />
    <FontFamily x:Key="OverlayValueFont">Consolas</FontFamily>

    <Style x:Key="OverlayPanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OverlayPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style x:Key="OverlayHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource OverlayTextBrush}" />
    </Style>

    <Style x:Key="OverlayLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource OverlayMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="OverlayValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{StaticResource OverlayValueFont}" />
        <Setter Property="Foreground" Value="{StaticResource OverlayTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="OverlayValueBig" TargetType="TextBlock" BasedOn="{StaticResource OverlayValue}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="OverlayEditOutline" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource OverlayAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="OverlayLiveDot" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Fill" Value="{StaticResource OverlayWarningBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLive}" Value="True">
                <Setter Property="Fill" Value="{StaticResource OverlaySuccessBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OverlayResizeGrip" TargetType="Thumb">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Cursor" Value="SizeNWSE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Path Data="M0,13 L13,0 M5,13 L13,5 M9,13 L13,9"
                              Stroke="{StaticResource OverlayAccentBrush}"
                              StrokeThickness="1.5"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Margin="0,0,2,2" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         Phase 2 visual primitives. These are the shared building blocks every
         overlay panel uses so styling stays consistent and centralised here.
         =================================================================== -->

    <SolidColorBrush x:Key="OverlaySelectedRowBrush" Color="#22B7F34A" />
    <SolidColorBrush x:Key="OverlayPitBrush" Color="#4D9AA0A6" />
    <SolidColorBrush x:Key="OverlayClassProBrush" Color="#FF4FA3FF" />
    <SolidColorBrush x:Key="OverlayClassAmBrush" Color="#FFFFC24D" />
    <SolidColorBrush x:Key="OverlayClassSilverBrush" Color="#FFD0D4DA" />

    <!-- Session/section heading: small, dim, uppercase-like emphasis. -->
    <Style x:Key="OverlaySectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource OverlayMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Dense table header cell. -->
    <Style x:Key="OverlayTableHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource OverlayMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Standard dense cell text. -->
    <Style x:Key="OverlayCellText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource OverlayTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="OverlayCellMuted" TargetType="TextBlock" BasedOn="{StaticResource OverlayCellText}">
        <Setter Property="Foreground" Value="{StaticResource OverlayMutedBrush}" />
    </Style>

    <!-- Monospaced cell for numbers such as gaps and positions. -->
    <Style x:Key="OverlayCellMono" TargetType="TextBlock" BasedOn="{StaticResource OverlayCellText}">
        <Setter Property="FontFamily" Value="{StaticResource OverlayValueFont}" />
    </Style>

    <!-- One standings/relative row. Highlights itself when the bound row is the
         player, using a DataTrigger so no per-row code is needed. -->
    <Style x:Key="OverlayRowBorder" TargetType="Border">
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlaySeparatorBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                <Setter Property="Background" Value="{StaticResource OverlaySelectedRowBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Thin class/driver colour marker at the left edge of a row. The colour is
         supplied per row via Background; this only fixes the shape. -->
    <Style x:Key="OverlayColourStripe" TargetType="Border">
        <Setter Property="Width" Value="3" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="CornerRadius" Value="1" />
    </Style>

    <Style x:Key="OverlaySeparator" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{StaticResource OverlaySeparatorBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Recessed track behind an OverlayBar. -->
    <Style x:Key="OverlayBarTrack" TargetType="Border">
        <Setter Property="Background" Value="#33FFFFFF" />
        <Setter Property="CornerRadius" Value="1" />
    </Style>

    <!-- Gear badge: a compact boxed number/symbol. -->
    <Style x:Key="OverlayGearBadge" TargetType="Border">
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
</ResourceDictionary>
