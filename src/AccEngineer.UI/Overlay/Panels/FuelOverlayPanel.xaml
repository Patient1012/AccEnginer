<UserControl x:Class="AccEngineer.UI.Overlay.Panels.FuelOverlayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oc="clr-namespace:AccEngineer.UI.Overlay.Controls"
             xmlns:conv="clr-namespace:AccEngineer.UI.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Border Style="{StaticResource OverlayPanelBorder}">
        <Grid Margin="6,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,2">
                <Border Width="3" Background="{DynamicResource OverlayAccentBrush}" Margin="0,0,6,0" />
                <TextBlock Text="FUEL" Style="{StaticResource OverlayHeader}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SourceText}" Margin="8,0,0,0"
                           Style="{StaticResource OverlayCellMuted}" VerticalAlignment="Center" />
            </StackPanel>
            <oc:OverlayStatusIndicator Grid.Row="0" Grid.Column="1"
                                       Text="{Binding StatusText}"
                                       IsActive="{Binding IsLive}"
                                       TestData="{Binding IsTestData}" />

            <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource OverlaySeparator}"
                       Margin="0,2,0,2" />

            <!-- Prominent result: fuel to add. Colour flips to the warning accent on a shortfall. -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="FUEL TO ADD" Style="{StaticResource OverlayLabel}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FuelToAddText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource OverlayValueBig}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasShortfall}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OverlayWarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSufficient}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OverlaySuccessBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Supporting values -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="LAPS POSSIBLE" Style="{StaticResource OverlayLabel}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LapsPossibleText}" Style="{StaticResource OverlayCellMono}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="CURRENT FUEL" Style="{StaticResource OverlayLabel}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentFuelText}" Style="{StaticResource OverlayCellMono}" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="CONSUMPTION" Style="{StaticResource OverlayLabel}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ConsumptionText}" Style="{StaticResource OverlayCellMono}" />

            <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding StatusLineText}"
                       Style="{StaticResource OverlayCellMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
        </Grid>
    </Border>
</UserControl>
