<UserControl x:Class="AccEngineer.UI.Overlay.Panels.InputsOverlayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oc="clr-namespace:AccEngineer.UI.Overlay.Controls"
             xmlns:ctl="clr-namespace:AccEngineer.UI.Controls">
    <!-- Gear + speed headline, live input bars and bounded rolling traces. -->
    <Border Style="{StaticResource OverlayPanelBorder}">
        <Grid Margin="6,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- header -->
                <RowDefinition Height="Auto" />   <!-- separator -->
                <RowDefinition Height="Auto" />   <!-- gear / speed -->
                <RowDefinition Height="Auto" />   <!-- throttle -->
                <RowDefinition Height="Auto" />   <!-- brake -->
                <RowDefinition Height="Auto" />   <!-- steering -->
                <RowDefinition Height="Auto" />   <!-- separator -->
                <RowDefinition Height="*" />      <!-- traces -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="3" Background="{StaticResource OverlayAccentBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="INPUTS" Style="{StaticResource OverlayHeader}" VerticalAlignment="Center" />
                </StackPanel>
                <oc:OverlayStatusIndicator Grid.Column="1" Text="{Binding StatusText}" IsActive="{Binding IsLive}" />
            </Grid>

            <Rectangle Grid.Row="1" Style="{StaticResource OverlaySeparator}" Margin="0,2,0,2" />

            <!-- Gear badge, speed, RPM -->
            <Grid Grid.Row="2" Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource OverlayGearBadge}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GearText}" Style="{StaticResource OverlayValueBig}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{Binding SpeedText}" Style="{StaticResource OverlayValueBig}" />
                    <TextBlock Text=" km/h" Style="{StaticResource OverlayLabel}" VerticalAlignment="Bottom" Margin="2,0,0,3" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding RpmText}" Style="{StaticResource OverlayCellMono}" HorizontalAlignment="Right" />
                    <TextBlock Text="RPM" Style="{StaticResource OverlaySectionHeader}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <!-- Throttle -->
            <Grid Grid.Row="3" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="THROTTLE" Style="{StaticResource OverlayLabel}" />
                <Border Grid.Column="1" Style="{StaticResource OverlayBarTrack}" Height="8" VerticalAlignment="Center">
                    <oc:OverlayBar Value="{Binding ThrottleBar}" Fill="{StaticResource OverlayThrottleBrush}" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding ThrottleText}" Style="{StaticResource OverlayCellMono}"
                           HorizontalAlignment="Right" />
            </Grid>

            <!-- Brake -->
            <Grid Grid.Row="4" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="BRAKE" Style="{StaticResource OverlayLabel}" />
                <Border Grid.Column="1" Style="{StaticResource OverlayBarTrack}" Height="8" VerticalAlignment="Center">
                    <oc:OverlayBar Value="{Binding BrakeBar}" Fill="{StaticResource OverlayBrakeBrush}" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding BrakeText}" Style="{StaticResource OverlayCellMono}"
                           HorizontalAlignment="Right" />
            </Grid>

            <!-- Steering -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="STEERING" Style="{StaticResource OverlayLabel}" />
                <Border Grid.Column="1" Style="{StaticResource OverlayBarTrack}" Height="8" VerticalAlignment="Center">
                    <Grid>
                        <!-- Centre reference so the magnitude bar reads as a steering axis. -->
                        <Rectangle Width="1" Fill="{StaticResource OverlaySeparatorBrush}"
                                   HorizontalAlignment="Center" />
                        <oc:OverlayBar Value="{Binding SteeringBar}" Fill="{StaticResource OverlaySteerBrush}" />
                    </Grid>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding SteeringText}" Style="{StaticResource OverlayCellMono}"
                           HorizontalAlignment="Right" />
            </Grid>

            <Rectangle Grid.Row="6" Style="{StaticResource OverlaySeparator}" Margin="0,3,0,3" />

            <!-- Bounded rolling traces (throttle/brake 0..1, steering -1..1). -->
            <Grid Grid.Row="7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ctl:TraceChart Grid.Row="0" Minimum="0" Maximum="1"
                                Stroke="{StaticResource OverlayThrottleBrush}" Values="{Binding ThrottleTrace}" />
                <ctl:TraceChart Grid.Row="1" Minimum="0" Maximum="1"
                                Stroke="{StaticResource OverlayBrakeBrush}" Values="{Binding BrakeTrace}" />
                <ctl:TraceChart Grid.Row="2" Minimum="-1" Maximum="1"
                                Stroke="{StaticResource OverlaySteerBrush}" Values="{Binding SteeringTrace}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
