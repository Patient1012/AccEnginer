<UserControl x:Class="AccEngineer.UI.Overlay.Panels.InputsOverlayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oc="clr-namespace:AccEngineer.UI.Overlay.Controls"
             xmlns:ctl="clr-namespace:AccEngineer.UI.Controls">
    <!-- Compact horizontal inputs strip. One row, everything vertically centred on a
         shared 72px band so the graph, pedal columns, gear/speed and wheel read as a
         single cohesive HUD: throttle/brake graph, then clutch/brake/throttle pedals,
         then gear over speed, then the steering wheel. -->
    <Border Style="{StaticResource OverlayPanelBorder}">
        <Grid Margin="8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Throttle (green) and brake (red) traces over a faint grid. -->
            <Border Grid.Column="0" Height="72" Background="#FF0A0A0A"
                    BorderBrush="{StaticResource OverlaySeparatorBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
                <Grid Margin="1">
                    <ctl:TraceChart Minimum="0" Maximum="1" ShowGrid="True"
                                    GridBrush="{StaticResource OverlaySeparatorBrush}"
                                    Stroke="{StaticResource OverlayThrottleBrush}"
                                    LineThickness="1.5" Values="{Binding ThrottleTrace}" />
                    <ctl:TraceChart Minimum="0" Maximum="1"
                                    Stroke="{StaticResource OverlayBrakeBrush}"
                                    LineThickness="1.5" Values="{Binding BrakeTrace}" />
                </Grid>
            </Border>

            <!-- Pedal columns on the same band, left to right: clutch, brake, throttle. -->
            <Grid Grid.Column="1" Height="72" Margin="12,0,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" ToolTip="Clutch">
                    <StackPanel Orientation="Horizontal" Height="6">
                        <Rectangle Width="3" Height="5" VerticalAlignment="Bottom" Fill="{StaticResource OverlayMutedBrush}" />
                        <Rectangle Width="3" Height="5" VerticalAlignment="Bottom" Margin="3,0,0,0" Fill="{StaticResource OverlayMutedBrush}" />
                        <Rectangle Width="3" Height="5" VerticalAlignment="Bottom" Margin="3,0,0,0" Fill="{StaticResource OverlayMutedBrush}" />
                    </StackPanel>
                    <Border Style="{StaticResource OverlayBarTrack}" Width="14" Height="66">
                        <oc:OverlayBar Orientation="Vertical" Value="{Binding ClutchBar}"
                                       Fill="{StaticResource OverlayTextBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="6,0,0,0" ToolTip="Brake">
                    <StackPanel Orientation="Horizontal" Height="6">
                        <Rectangle Width="3" Height="5" VerticalAlignment="Bottom" Fill="{StaticResource OverlayMutedBrush}" />
                        <Rectangle Width="3" Height="5" VerticalAlignment="Bottom" Margin="3,0,0,0" Fill="{StaticResource OverlayMutedBrush}" />
                        <Rectangle Width="3" Height="5" VerticalAlignment="Bottom" Margin="3,0,0,0" Fill="{StaticResource OverlayMutedBrush}" />
                    </StackPanel>
                    <Border Style="{StaticResource OverlayBarTrack}" Width="14" Height="66">
                        <oc:OverlayBar Orientation="Vertical" Value="{Binding BrakeBar}"
                                       Fill="{StaticResource OverlayBrakeBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="6,0,0,0" ToolTip="Throttle">
                    <StackPanel Orientation="Horizontal" Height="6">
                        <Rectangle Width="3" Height="5" VerticalAlignment="Bottom" Fill="{StaticResource OverlayMutedBrush}" />
                        <Rectangle Width="3" Height="5" VerticalAlignment="Bottom" Margin="3,0,0,0" Fill="{StaticResource OverlayMutedBrush}" />
                        <Rectangle Width="3" Height="5" VerticalAlignment="Bottom" Margin="3,0,0,0" Fill="{StaticResource OverlayMutedBrush}" />
                    </StackPanel>
                    <Border Style="{StaticResource OverlayBarTrack}" Width="14" Height="66">
                        <oc:OverlayBar Orientation="Vertical" Value="{Binding ThrottleBar}"
                                       Fill="{StaticResource OverlayThrottleBrush}" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Gear over speed (kph label above the number), same vertical centre. -->
            <StackPanel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding GearText}" Style="{StaticResource OverlayValueBig}"
                           FontSize="28" HorizontalAlignment="Center" />
                <TextBlock Text="kph" Style="{StaticResource OverlaySectionHeader}"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                <TextBlock Text="{Binding SpeedText}" Style="{StaticResource OverlayValueBig}"
                           FontSize="20" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Steering wheel: rotates to the current steering angle. -->
            <oc:SteeringWheel Grid.Column="3" Margin="18,0,0,0" Width="64" Height="64"
                              VerticalAlignment="Center"
                              Value="{Binding SteeringAngle}"
                              RimBrush="{StaticResource OverlayTextBrush}"
                              SpokeBrush="{StaticResource OverlayMutedBrush}"
                              HubBrush="{StaticResource OverlayTextBrush}"
                              MarkerBrush="{StaticResource OverlayBrakeBrush}" />
        </Grid>
    </Border>
</UserControl>
