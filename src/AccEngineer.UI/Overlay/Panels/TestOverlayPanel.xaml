<overlay:OverlayWindowBase x:Class="AccEngineer.UI.Overlay.Panels.TestOverlayPanel"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:overlay="clr-namespace:AccEngineer.UI.Overlay"
                           xmlns:oc="clr-namespace:AccEngineer.UI.Overlay.Controls"
                           xmlns:conv="clr-namespace:AccEngineer.UI.Converters"
                           Title="ACC Engineer Overlay (test)"
                           Width="300"
                           Height="230">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Style="{StaticResource OverlayPanelBorder}" MouseLeftButtonDown="OnPanelMouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource OverlayHeaderBrush}">
                <Grid Margin="8,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="3" Background="{DynamicResource OverlayAccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="ACC ENGINEER" Style="{StaticResource OverlayHeader}" VerticalAlignment="Center" />

                    <oc:OverlayStatusIndicator Grid.Column="2"
                                               Text="{Binding StatusText}"
                                               IsActive="{Binding IsLive}"
                                               TestData="{Binding IsTestData}"
                                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource OverlaySeparatorBrush}" />

            <!-- Body -->
            <Grid Grid.Row="2" Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="SPEED" Style="{StaticResource OverlayLabel}" Margin="0,0,0,2" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SpeedText}" Style="{StaticResource OverlayValueBig}" Margin="0,0,0,2" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="GEAR" Style="{StaticResource OverlayLabel}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GearText}" Style="{StaticResource OverlayValue}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="RPM" Style="{StaticResource OverlayLabel}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RpmText}" Style="{StaticResource OverlayValue}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="LAP" Style="{StaticResource OverlayLabel}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LapText}" Style="{StaticResource OverlayValue}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="LAST" Style="{StaticResource OverlayLabel}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastLapText}" Style="{StaticResource OverlayValue}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="BEST" Style="{StaticResource OverlayLabel}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding BestLapText}" Style="{StaticResource OverlayValue}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="SESSION" Style="{StaticResource OverlayLabel}" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SessionText}" Style="{StaticResource OverlayValue}" />
            </Grid>

            <!-- Edit-mode chrome: outline + resize grip (locked mode is click-through) -->
            <Border Grid.Row="0"
                    Grid.RowSpan="3"
                    Style="{StaticResource OverlayEditOutline}"
                    Visibility="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=overlay:OverlayWindowBase}, Converter={StaticResource BoolToVis}}" />

            <Thumb Grid.Row="0"
                   Grid.RowSpan="3"
                   Style="{StaticResource OverlayResizeGrip}"
                   DragDelta="OnResizeGripDragDelta"
                   Visibility="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=overlay:OverlayWindowBase}, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Border>
</overlay:OverlayWindowBase>
