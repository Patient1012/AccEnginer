<UserControl x:Class="AccEngineer.UI.Overlay.Panels.TimingOverlayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oc="clr-namespace:AccEngineer.UI.Overlay.Controls"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!-- Compact timing HUD: a narrow header with an amber accent, then a two-column
         metrics body (labels left, tabular values right). The current lap is the single
         emphasised value; last/personal-best/sector/delta use restrained styling. All
         surfaces and accents come from the shared overlay theme brushes so the panel
         follows the active theme. -->
    <UserControl.Resources>
        <!-- Header title: small, semibold, uppercase feel. -->
        <Style x:Key="TmTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource OverlayTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Header context (track/session) in muted text, smaller than the title. -->
        <Style x:Key="TmContext" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource OverlayMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- Metric label: left-aligned, muted. -->
        <Style x:Key="TmLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource OverlayMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Standard metric value: right-aligned, tabular digits. -->
        <Style x:Key="TmValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontFamily" Value="{StaticResource OverlayValueFont}" />
            <Setter Property="Foreground" Value="{DynamicResource OverlayTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Primary value (current lap): larger, bold, amber; dims to muted when unavailable. -->
        <Style x:Key="TmCurrent" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="{StaticResource OverlayValueFont}" />
            <Setter Property="Foreground" Value="{DynamicResource OverlayAccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentLapText}" Value="--">
                    <Setter Property="Foreground" Value="{DynamicResource OverlayMutedBrush}" />
                    <Setter Property="FontWeight" Value="Normal" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource OverlayPanelBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="22" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: amber accent, title, muted context, status indicator. -->
            <Grid Grid.Row="0" Background="{DynamicResource OverlayHeaderBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="3" Margin="6,5,6,5"
                        Background="{DynamicResource OverlayAccentBrush}" />

                <TextBlock Grid.Column="1" Text="TIMING" Style="{StaticResource TmTitle}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,6,0">
                    <TextBlock Text="{Binding SessionTextSecondary}" Style="{StaticResource TmContext}" />
                </StackPanel>

                <oc:OverlayStatusIndicator Grid.Column="3" Margin="0,0,8,0"
                                           Text="{Binding StatusText}"
                                           IsActive="{Binding IsLive}"
                                           TestData="{Binding IsTestData}" />
            </Grid>

            <Rectangle Grid.Row="1" Fill="{DynamicResource OverlaySeparatorBrush}" />

            <!-- Metrics: consistent rows, labels left / values right. -->
            <Grid Grid.Row="2" Margin="8,4,8,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="21" />
                    <RowDefinition Height="21" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="21" />
                    <RowDefinition Height="21" />
                    <RowDefinition Height="21" />
                    <RowDefinition Height="21" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="SESSION" Style="{StaticResource TmLabel}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SessionText}" Style="{StaticResource TmValue}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="LAP" Style="{StaticResource TmLabel}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LapText}" Style="{StaticResource TmValue}" />

                <Rectangle Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                           Height="1" Fill="{DynamicResource OverlaySeparatorBrush}" VerticalAlignment="Center" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="CURRENT" Style="{StaticResource TmLabel}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentLapText}" Style="{StaticResource TmCurrent}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="LAST" Style="{StaticResource TmLabel}" />
                <oc:OverlayTimingValue Grid.Row="4" Grid.Column="1" FontSize="13"
                                       Text="{Binding LastLapText}"
                                       State="{Binding LastLapState}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="PERSONAL BEST" Style="{StaticResource TmLabel}" />
                <oc:OverlayTimingValue Grid.Row="5" Grid.Column="1" FontSize="13"
                                       Text="{Binding PersonalBestText}"
                                       State="{Binding PersonalBestState}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="SECTOR" Style="{StaticResource TmLabel}" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SectorText}" Style="{StaticResource TmValue}" />

                <TextBlock Grid.Row="7" Grid.Column="0" Text="DELTA" Style="{StaticResource TmLabel}" />
                <oc:OverlayTimingValue Grid.Row="7" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                       Text="{Binding DeltaText}"
                                       State="{Binding DeltaState}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
