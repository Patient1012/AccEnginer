<UserControl x:Class="AccEngineer.UI.Overlay.Panels.TimingOverlayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oc="clr-namespace:AccEngineer.UI.Overlay.Controls">
    <!-- Classic RaceLab-inspired timing block: compact, dark translucent, tabular digits. -->
    <Border Style="{StaticResource OverlayPanelBorder}">
        <Grid Margin="6,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,2">
                <Border Width="3" Background="{DynamicResource OverlayAccentBrush}" Margin="0,0,6,0" />
                <TextBlock Text="TIMING" Style="{StaticResource OverlayHeader}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SessionTextSecondary}" Margin="8,0,0,0"
                           Style="{StaticResource OverlayCellMuted}" VerticalAlignment="Center" />
            </StackPanel>
            <oc:OverlayStatusIndicator Grid.Row="0" Grid.Column="1"
                                       Text="{Binding StatusText}"
                                       IsActive="{Binding IsLive}"
                                       TestData="{Binding IsTestData}" />

            <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource OverlaySeparator}"
                       Margin="0,2,0,2" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="SESSION" Style="{StaticResource OverlayLabel}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SessionText}" Style="{StaticResource OverlayCellMono}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="LAP" Style="{StaticResource OverlayLabel}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LapText}" Style="{StaticResource OverlayCellMono}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="CURRENT" Style="{StaticResource OverlayLabel}" />
            <oc:OverlayTimingValue Grid.Row="4" Grid.Column="1"
                                   Text="{Binding CurrentLapText}"
                                   State="{Binding CurrentLapState}" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="LAST" Style="{StaticResource OverlayLabel}" />
            <oc:OverlayTimingValue Grid.Row="5" Grid.Column="1"
                                   Text="{Binding LastLapText}"
                                   State="{Binding LastLapState}" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="PERSONAL BEST" Style="{StaticResource OverlayLabel}" />
            <oc:OverlayTimingValue Grid.Row="6" Grid.Column="1"
                                   Text="{Binding PersonalBestText}"
                                   State="{Binding PersonalBestState}" />
        </Grid>
    </Border>
</UserControl>
