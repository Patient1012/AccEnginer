<UserControl x:Class="AccEngineer.UI.Overlay.Panels.VehicleDynamicsOverlayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oc="clr-namespace:AccEngineer.UI.Overlay.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="CornerCell">
            <Border Margin="2" Padding="4,2" Background="{DynamicResource OverlayGraphBgBrush}"
                    BorderBrush="{DynamicResource OverlayBorderBrush}" BorderThickness="1" CornerRadius="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource OverlaySectionHeader}" />
                    <TextBlock Grid.Column="1" Text="{Binding TravelText}" Style="{StaticResource OverlayCellMono}"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource OverlayPanelBorder}">
        <Grid Margin="6,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,2">
                <Border Width="3" Background="{DynamicResource OverlayAccentBrush}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding HeaderText}" Style="{StaticResource OverlayHeader}" VerticalAlignment="Center" />
            </StackPanel>
            <oc:OverlayStatusIndicator Grid.Row="0" Grid.Column="1"
                                       Text="{Binding StatusText}"
                                       IsActive="{Binding IsLive}"
                                       TestData="{Binding IsTestData}" />

            <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource OverlaySeparator}"
                       Margin="0,2,0,2" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="SPEED" Style="{StaticResource OverlayLabel}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SpeedText}" Style="{StaticResource OverlayCellMono}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="LAT / LONG G" Style="{StaticResource OverlayLabel}" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding LateralGText}" Style="{StaticResource OverlayCellMono}" />
                <TextBlock Text=" / " Style="{StaticResource OverlayCellMuted}" />
                <TextBlock Text="{Binding LongitudinalGText}" Style="{StaticResource OverlayCellMono}" />
            </StackPanel>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="YAW" Style="{StaticResource OverlayLabel}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding YawText}" Style="{StaticResource OverlayCellMono}" />

            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="SUSPENSION TRAVEL (mm)"
                       Style="{StaticResource OverlaySectionHeader}" Margin="0,6,0,0" />

            <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Row="0" Grid.Column="0" Content="{Binding FrontLeft}" ContentTemplate="{StaticResource CornerCell}" />
                <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding FrontRight}" ContentTemplate="{StaticResource CornerCell}" />
                <ContentControl Grid.Row="1" Grid.Column="0" Content="{Binding RearLeft}" ContentTemplate="{StaticResource CornerCell}" />
                <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding RearRight}" ContentTemplate="{StaticResource CornerCell}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
