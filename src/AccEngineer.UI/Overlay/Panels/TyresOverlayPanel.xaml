<UserControl x:Class="AccEngineer.UI.Overlay.Panels.TyresOverlayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oc="clr-namespace:AccEngineer.UI.Overlay.Controls">
    <UserControl.Resources>
        <!-- One corner: label, tyre core temp, pressure, brake temp. -->
        <DataTemplate x:Key="TyreCell">
            <Border Margin="1" Padding="3,2" Background="{DynamicResource OverlayGraphBgBrush}"
                    BorderBrush="{DynamicResource OverlayBorderBrush}" BorderThickness="1" CornerRadius="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Label}"
                               Style="{StaticResource OverlaySectionHeader}" Margin="0,0,0,0" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="TYRE" Style="{StaticResource OverlayLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TempText}" Style="{StaticResource OverlayCellMono}"
                               HorizontalAlignment="Right" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="PRESS" Style="{StaticResource OverlayLabel}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PressureText}" Style="{StaticResource OverlayCellMono}"
                               HorizontalAlignment="Right" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="BRAKE" Style="{StaticResource OverlayLabel}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BrakeText}" Style="{StaticResource OverlayCellMono}"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource OverlayPanelBorder}">
        <Grid Margin="6,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,2">
                <Border Width="3" Background="{DynamicResource OverlayAccentBrush}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding HeaderText}" Style="{StaticResource OverlayHeader}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CompoundText}" Margin="8,0,0,0"
                           Style="{StaticResource OverlayCellMuted}" VerticalAlignment="Center" />
            </StackPanel>
            <oc:OverlayStatusIndicator Grid.Row="0" Grid.Column="1"
                                       Text="{Binding StatusText}"
                                       IsActive="{Binding IsLive}"
                                       TestData="{Binding IsTestData}" />

            <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource OverlaySeparator}"
                       Margin="0,2,0,2" />

            <!-- 2x2 corner layout: FL FR / RL RR -->
            <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,1,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Row="0" Grid.Column="0" Content="{Binding FrontLeft}" ContentTemplate="{StaticResource TyreCell}" />
                <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding FrontRight}" ContentTemplate="{StaticResource TyreCell}" />
                <ContentControl Grid.Row="1" Grid.Column="0" Content="{Binding RearLeft}" ContentTemplate="{StaticResource TyreCell}" />
                <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding RearRight}" ContentTemplate="{StaticResource TyreCell}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
