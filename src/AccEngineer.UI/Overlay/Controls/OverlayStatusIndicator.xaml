<UserControl x:Class="AccEngineer.UI.Overlay.Controls.OverlayStatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AccEngineer.UI.Overlay.Controls">
    <!-- Small dot + label used for connection/telemetry status across panels. -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource OverlayWarningBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=local:OverlayStatusIndicator}}"
                                     Value="True">
                            <Setter Property="Fill" Value="{DynamicResource OverlaySuccessBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
        </Ellipse>
        <TextBlock Margin="6,0,0,0"
                   VerticalAlignment="Center"
                   Style="{StaticResource OverlayHeader}"
                   Text="{Binding Text, RelativeSource={RelativeSource AncestorType=local:OverlayStatusIndicator}}" />
    </StackPanel>
</UserControl>
