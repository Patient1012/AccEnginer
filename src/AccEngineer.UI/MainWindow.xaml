<Window x:Class="AccEngineer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AccEngineer.UI.ViewModels"
        xmlns:views="clr-namespace:AccEngineer.UI.Views"
        xmlns:controls="clr-namespace:AccEngineer.UI.Controls"
        Title="ACC Engineer" Height="820" Width="1280"
        MinHeight="600" MinWidth="1000"
        Background="{DynamicResource BrushBackground}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LiveDataViewModel}">
            <views:LiveDataView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalysisViewModel}">
            <views:AnalysisView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LiveReportViewModel}">
            <views:LiveReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SessionsViewModel}">
            <views:SessionsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FuelCalculatorViewModel}">
            <views:FuelCalculatorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RaceEngineerViewModel}">
            <views:RaceEngineerView />
        </DataTemplate>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConnectionDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource BrushTextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status.Connection}" Value="Connected">
                    <Setter Property="Fill" Value="{DynamicResource BrushSuccess}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.Connection}" Value="TestData">
                    <Setter Property="Fill" Value="{DynamicResource BrushWarning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.Connection}" Value="Replay">
                    <Setter Property="Fill" Value="{DynamicResource BrushAccent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.Connection}" Value="WaitingForAcc">
                    <Setter Property="Fill" Value="{DynamicResource BrushWarning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.Connection}" Value="Error">
                    <Setter Property="Fill" Value="{DynamicResource BrushError}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecordButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Content" Value="Start Recording" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status.IsRecording}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushError}" />
                    <Setter Property="Content" Value="Stop Recording" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:Logo Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="ACC Engineer" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="28,0,0,0">
                    <Ellipse Style="{StaticResource ConnectionDot}" />
                    <TextBlock Text="{Binding Status.ConnectionText}" FontWeight="SemiBold" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource BrushBorder}" Margin="18,0" />
                    <TextBlock Text="{Binding Status.SessionText}" Foreground="{DynamicResource BrushTextSecondary}"
                               VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource BrushBorder}" Margin="18,0" />
                    <TextBlock Text="{Binding Status.TrackText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status.CarText}" Margin="16,0,0,0"
                               Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />

                    <Border Margin="16,0,0,0" Padding="7,2" CornerRadius="3" VerticalAlignment="Center"
                            Background="{DynamicResource BrushWarning}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status.IsTestData}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="TEST DATA" FontSize="10" FontWeight="Bold"
                                   Foreground="#1A1A1A" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status.RecordingText}" Margin="0,0,14,0"
                               Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                    <Button Content="Start Recording" Style="{StaticResource RecordButton}"
                            Command="{Binding ToggleRecordingCommand}" />
                    <Button Content="Sessions" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                            Command="{Binding OpenSessionsCommand}" />
                    <Button Content="Settings" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                            Command="{Binding OpenSettingsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
                <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding CurrentPage}" ItemContainerStyle="{StaticResource NavItem}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{Binding NavIcon}" Stretch="Uniform" Height="14" Fill="{DynamicResource BrushTextPrimary}"
                              Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" FontSize="14" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
