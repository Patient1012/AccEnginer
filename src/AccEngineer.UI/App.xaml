<Application x:Class="AccEngineer.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AccEngineer.UI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/OverlayClassic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToEnabledTextConverter x:Key="BoolToEnabledText" xmlns:local="clr-namespace:AccEngineer.UI.Converters" />
            <local:BoolToMuteTextConverter x:Key="BoolToMuteText" xmlns:local="clr-namespace:AccEngineer.UI.Converters" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
